---
// A hairline with ring ends and a centre mark. Draws outward from the middle when scrolled into view.
---
<div class="wrap py-2 md:py-4" aria-hidden="true">
  <div class="flex items-center gap-3">
    <span class="size-2.5 shrink-0 rounded-full border border-green/50 bg-paper"></span>
    <span data-reveal="line" class="h-px flex-1 origin-right bg-green/25"></span>
    <span data-reveal="pop" class="grid size-7 shrink-0 place-items-center rounded-full border border-green/30 bg-white shadow-field"><span class="size-1.5 rounded-full bg-green"></span></span>
    <span data-reveal="line" class="h-px flex-1 origin-left bg-green/25"></span>
    <span class="size-2.5 shrink-0 rounded-full border border-green/50 bg-paper"></span>
  </div>
</div>
