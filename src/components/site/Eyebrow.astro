---
import { Compass, SquaresFour, Question, BellRinging, Handshake, ChartLineUp, PaperPlaneTilt, ChatCircleDots, Hammer, MagnifyingGlass, Stack, GearSix, Lightning, Lightbulb, Star, WarningCircle, Package, CursorClick } from '@phosphor-icons/react';
const map = { Compass, SquaresFour, Question, BellRinging, Handshake, ChartLineUp, PaperPlaneTilt, ChatCircleDots, Hammer, MagnifyingGlass, Stack, GearSix, Lightning, Lightbulb, Star, WarningCircle, Package, CursorClick } as const;
interface Props { icon: keyof typeof map; dark?: boolean; class?: string }
const { icon, dark = false, class: cls = '' } = Astro.props;
const I = map[icon];
---
<span class:list={['inline-flex items-center gap-2 border py-1.5 pr-4 pl-1.5 text-sm font-semibold leading-none', dark ? 'border-white/25 bg-white/10 text-white' : 'border-line bg-white text-ink shadow-field', cls]}>
  <span class:list={['grid size-7 place-items-center', dark ? 'bg-pistachio text-ink' : 'bg-mist text-green']}><I size={14} weight="duotone" /></span>
  <slot />
</span>
