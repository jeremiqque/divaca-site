---
interface Props { tone?: 'green' | 'pistachio' | 'ink' | 'mist'; size?: number; class?: string; [k: string]: unknown }
const { tone = 'green', size = 96, class: cls = '', ...rest } = Astro.props;
const fills = { green: ['#1f8a4f', '#0b4626', '#fff'], pistachio: ['#a9e08c', '#6fb64b', '#0c1d13'], ink: ['#25362b', '#0c1d13', '#8ed06c'], mist: ['#ffffff', '#cfe6c4', '#105e34'] }[tone];
const id = `c${Math.random().toString(36).slice(2, 8)}`;
const pts = Array.from({ length: 96 }, (_, i) => {
  const a = (i / 96) * Math.PI * 2;
  const r = i % 2 ? 47 : 50;
  return `${(50 + r * Math.cos(a)).toFixed(2)},${(50 + r * Math.sin(a)).toFixed(2)}`;
}).join(' ');
---
<span class:list={['relative inline-grid place-items-center', cls]} style={`width:${size}px;height:${size}px;color:${fills[2]}`} aria-hidden="true" {...rest}>
  <svg viewBox="0 0 100 100" class="absolute inset-0 size-full drop-shadow-[0_3px_3px_rgba(8,50,28,0.18)]">
    <defs><linearGradient id={id} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color={fills[0]} /><stop offset="1" stop-color={fills[1]} /></linearGradient></defs>
    <polygon points={pts} fill={`url(#${id})`} />
    <circle cx="50" cy="50" r="38" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="1.5" stroke-dasharray="2 3" />
  </svg>
  <span class="relative"><slot /></span>
</span>
