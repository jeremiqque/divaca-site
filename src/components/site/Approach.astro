---
import Eyebrow from '@/components/site/Eyebrow.astro';
import { MagnifyingGlass, Hammer, UsersThree } from '@phosphor-icons/react';
import Coin from './Coin.astro';
const steps = [
  { Icon: MagnifyingGlass, tone: 'green', title: 'Start with a real problem', text: 'Every Divaca product begins with something people already struggle with: a notice that arrives too late, a service that is hard to reach, a place to learn that does not exist yet.' },
  { Icon: Hammer, tone: 'pistachio', title: 'Build the smallest version', text: 'We make a first version that solves that one problem well, instead of a long feature list nobody asked for.' },
  { Icon: UsersThree, tone: 'mist', title: 'Learn with the people it is for', text: 'We put it in front of real users and improve it from what we learn. Campus Update started that way, as a pilot with the Computer Science department at FOCIT.' },
] as const;
---
<section class="py-24 md:py-32">
  <div class="wrap">
    <p><Eyebrow icon="Compass">How we work</Eyebrow></p>
    <h2 class="h-section mt-5 max-w-4xl">One method. <span class="text-ink/50">Every product.</span></h2>
    <ol class="relative mt-14 grid border-y border-line md:grid-cols-3">
      {['left-1/3', 'left-2/3'].flatMap((x) => ['top-0', 'bottom-0'].map((y) => <span aria-hidden="true" class={`absolute ${x} ${y} z-10 hidden size-2.5 -translate-x-1/2 -translate-y-1/2 border border-ink bg-paper md:block`}></span>))}
      {steps.map((s, i) => (
        <li class="relative flex flex-col items-center border-b border-line px-6 py-12 text-center last:border-b-0 md:border-b-0 md:border-r md:px-10 md:py-16 md:last:border-r-0">
          <p class="label absolute left-5 top-5 text-muted">0{i + 1}</p>
          <Coin tone={s.tone} size={84}><s.Icon size={34} weight="fill" /></Coin>
          <h3 class="mt-8 text-xl font-semibold tracking-tight">{s.title}</h3>
          <p class="mt-3 max-w-sm text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
