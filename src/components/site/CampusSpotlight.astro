---
import Eyebrow from '@/components/site/Eyebrow.astro';
import { ArrowUpRight } from '@phosphor-icons/react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { products } from '@/lib/products';
const cu = products.find((p) => p.slug === 'campus-update')!;
const d = cu.detail!;
---
<section class="scene grad-green py-24 text-white md:py-32">
  <div class="wrap grid gap-16 md:grid-cols-[1.15fr_1fr] md:gap-20">
    <div>
      <p><Eyebrow icon="Star" dark>Featured · Campus Update</Eyebrow></p>
      <h2 class="h-section mt-5">Campus news should not travel <span class="ul-draw text-pistachio">by forwarded screenshot.</span></h2>
      <p class="mt-7 max-w-xl text-lg text-white/85">{d.problem.text}</p>
      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href={cu.url} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: 'accent', size: 'lg' }))}>
          Open Campus Update <ArrowUpRight weight="bold" /><span class="sr-only">(opens in a new tab)</span>
        </a>
        <a href="/products/campus-update" class="font-semibold underline decoration-2 underline-offset-8 hover:text-pistachio">Bring it to your school</a>
      </div>
    </div>
    <ol class="relative self-end">
      {d.steps.map((s, i) => (
        <li class="relative grid grid-cols-[2rem_1fr] gap-5 pb-8 last:pb-0">
          {i < d.steps.length - 1 && <span aria-hidden="true" class="absolute left-4 top-8 h-full border-l border-dashed border-white/50"></span>}
          {i < d.steps.length - 1 && <span aria-hidden="true" class="step-line absolute left-[15px] top-8 h-full w-0.5 bg-pistachio" style={`--k:${i}`}></span>}
          <span class="step-num relative grid size-8 place-items-center bg-white text-sm font-bold text-green" style={`--k:${i}`}>{i + 1}</span>
          <div class="pt-0.5"><p class="step-title text-lg font-bold" style={`--k:${i}`}>{s.title}</p><p class="text-white/80">{s.text}</p></div>
        </li>
      ))}
    </ol>
  </div>
</section>
