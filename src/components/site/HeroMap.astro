---
import { Bell, Code, Heart, GameController, GraduationCap } from '@phosphor-icons/react';
import Coin from './Coin.astro';
// Route-map illustration: faint streets, one green route linking the five products.
const pins = [
  { x: 20, y: 70, tone: 'green', Icon: Bell, label: 'Campus Update', size: 64 },
  { x: 40, y: 44, tone: 'pistachio', Icon: Code, label: 'Divaca Tech', size: 52 },
  { x: 68, y: 58, tone: 'mist', Icon: Heart, label: 'Divaca Health', size: 52 },
  { x: 60, y: 16, tone: 'ink', Icon: GameController, label: 'PlaySphere', size: 52 },
  { x: 80, y: 28, tone: 'pistachio', Icon: GraduationCap, label: 'Innovative Hub', size: 52 },
] as const;
const route = '20,70 28,70 28,44 40,44 40,58 68,58 68,36 60,36 60,16 80,16 80,28';
---
<div class="relative h-[420px] w-full overflow-hidden border border-line bg-white md:h-[520px]" aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="absolute inset-0 size-full">
    <g stroke="#d6d9cd" stroke-width="0.35" fill="none" vector-effect="non-scaling-stroke">
      <path d="M0 22 L100 12 M0 48 L100 40 M0 78 L100 84 M0 94 L100 90" />
      <path d="M10 0 L16 100 M34 0 L30 100 M52 0 L58 100 M76 0 L72 100 M92 0 L96 100" />
      <path d="M0 62 L48 30 L100 62" />
      <path d="M20 100 L56 62 L100 8" />
    </g>
    <g stroke="#e8ebe1" stroke-width="3.2" fill="none" stroke-linecap="square" vector-effect="non-scaling-stroke" opacity=".7">
      <path d="M0 35 L100 28" /><path d="M45 0 L50 100" />
    </g>
    <polyline points={route} fill="none" stroke="#105e34" stroke-width="2.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
    <polyline points={route} fill="none" stroke="#8ed06c" stroke-width="1" stroke-dasharray="3 6" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
  </svg>
  {pins.map((p) => (
    <div class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${p.x}%;top:${p.y}%`}>
      <Coin tone={p.tone} size={p.size}><p.Icon size={p.size * 0.42} weight="fill" /></Coin>
      <p class="absolute left-1/2 top-full mt-1.5 -translate-x-1/2 whitespace-nowrap border border-line bg-paper px-2 py-0.5 text-[11px] font-semibold leading-tight shadow-sm">{p.label}</p>
    </div>
  ))}
</div>
